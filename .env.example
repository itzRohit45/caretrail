# Copy to .env.local and fill in. See README for where each value comes from.

# ---------------------------------------------------------------
# 1. SUPABASE  (supabase.com -> your project)
# ---------------------------------------------------------------
# Connect button (top of project) -> Project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> Publishable key (sb_publishable_...) or legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings -> API Keys -> Secret key (sb_secret_...) or legacy "service_role" key
SUPABASE_SECRET_KEY=
# Connect -> Session pooler string, with [YOUR-PASSWORD] replaced. Used only on this laptop for migrations.
SUPABASE_DB_URL=

# ---------------------------------------------------------------
# 2. AI EXTRACTION  (fill ONLY ONE of these three)
# ---------------------------------------------------------------
# Free: aistudio.google.com -> Get API key
GEMINI_API_KEY=

# ---------------------------------------------------------------
# 3. EMAIL ALERTS  (brevo.com)
# ---------------------------------------------------------------
# Settings -> SMTP & API -> "API keys & MCP" tab -> Generate a new API key (xkeysib-...)
BREVO_API_KEY=
# Your VERIFIED sender email (Settings -> Senders, domains, IPs -> Senders)
ALERT_FROM_EMAIL=

# ---------------------------------------------------------------
# 4. FILLED BY CLAUDE, do not edit
# ---------------------------------------------------------------
IP_HASH_SALT=
